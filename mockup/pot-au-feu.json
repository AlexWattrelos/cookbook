{
  "id": "pot-au-feu",
  "title": "Pot-au-Feu",
  "course": "main",
  "status": "draft",
  "tags": ["red-meat", "french", "winter", "weekend", "guests"],
  "servings": 4,
  "yield": null,
  "time": { "active": 60, "total": 210 },
  "ahead": "Start 3.5 h before serving. Marrow bones soak 2 h.",
  "notes": ["Skim thoroughly at the start or the broth stays cloudy."],
  "source": null,
  "ingredients": [
    { "id": "chuck", "amount": 600, "unit": "g", "name": "beef chuck (paleron)", "prep": null, "category": "meat-fish" },
    { "id": "shank", "amount": 600, "unit": "g", "name": "bone-in beef shank (gîte)", "prep": null, "category": "meat-fish" },
    { "id": "water", "amount": 3, "unit": "l", "name": "cold water", "prep": null, "category": "staple" },
    { "id": "onion", "amount": 2, "unit": null, "name": "onions", "prep": "peeled and halved", "category": "produce" },
    { "id": "clove", "amount": 4, "unit": null, "name": "whole cloves", "prep": null, "category": "pantry" },
    { "id": "thyme", "amount": 4, "unit": null, "name": "thyme sprigs", "prep": null, "category": "produce" },
    { "id": "bay", "amount": 2, "unit": null, "name": "bay leaves", "prep": null, "category": "produce" },
    { "id": "parsley-stems", "amount": 10, "unit": "g", "name": "flat-leaf parsley", "prep": "stems only, tied together", "category": "produce" },
    { "id": "peppercorns", "amount": 1, "unit": "tsp", "name": "black peppercorns", "prep": null, "category": "staple" },
    { "id": "salt", "amount": 1, "unit": "tbsp", "name": "salt", "prep": null, "category": "staple" },
    { "id": "parsley-leaves", "amount": 30, "unit": "g", "name": "flat-leaf parsley", "prep": "leaves picked", "category": "produce" },
    { "id": "cornichon", "amount": 6, "unit": null, "name": "cornichons", "prep": null, "category": "canned" },
    { "id": "capers", "amount": 2, "unit": "tbsp", "name": "capers", "prep": null, "category": "canned" },
    { "id": "fish-sauce", "amount": 1, "unit": "tsp", "name": "fish sauce", "prep": null, "category": "pantry" },
    { "id": "vinegar", "amount": 1, "unit": "tbsp", "name": "red wine vinegar", "prep": null, "category": "pantry" },
    { "id": "olive-oil", "amount": 80, "unit": "ml", "name": "olive oil", "prep": null, "category": "pantry" },
    { "id": "pepper", "amount": null, "unit": null, "name": "black pepper", "prep": null, "category": "staple" },
    { "id": "cabbage", "amount": 200, "unit": "g", "name": "savoy cabbage", "prep": "cut into wedges, core trimmed but left attached", "category": "produce" },
    { "id": "leek", "amount": 2, "unit": null, "name": "leeks", "prep": "trimmed, halved lengthwise, washed, tied into a bundle", "category": "produce" },
    { "id": "carrot", "amount": 200, "unit": "g", "name": "carrots", "prep": "peeled, cut into 8 cm lengths", "category": "produce" },
    { "id": "turnip", "amount": 150, "unit": "g", "name": "turnips", "prep": "peeled and quartered", "category": "produce" },
    { "id": "celeriac", "amount": 150, "unit": "g", "name": "celeriac", "prep": "peeled, cut into large wedges", "category": "produce" },
    { "id": "potato", "amount": 400, "unit": "g", "name": "waxy potatoes", "prep": "peeled and halved", "category": "produce" },
    { "id": "marrow", "amount": 4, "unit": null, "name": "marrow bones, 5 cm pieces", "prep": "soaked 2 h in cold salted water, drained and rinsed", "category": "meat-fish" },
    { "id": "sea-salt", "amount": null, "unit": null, "name": "coarse sea salt", "prep": null, "category": "staple" },
    { "id": "bread", "amount": 4, "unit": null, "name": "thick slices rustic bread", "prep": null, "category": "bakery" },
    { "id": "garlic", "amount": 2, "unit": null, "name": "garlic cloves", "prep": "halved", "category": "produce" },
    { "id": "mustard", "amount": null, "unit": null, "name": "Dijon mustard", "prep": null, "category": "pantry" }
  ],
  "steps": [
    { "section": "Broth", "text": "Put {chuck} and {shank} in a large pot, cover with {water} and bring to a boil. Skim until the broth stays clear.", "timer": 5 },
    { "section": null, "text": "Stud {onion} with {clove}. Add to the pot with {thyme}, {bay}, {peppercorns}, {salt} and {parsley-stems}.", "timer": null },
    { "section": null, "text": "Reduce to the gentlest simmer, an occasional bubble only. Partially cover.", "timer": 150 },
    { "section": "Sauce verte", "text": "Pulse {cornichon}, {capers}, {fish-sauce}, {vinegar} and {parsley-leaves} in a small blender until roughly chopped.", "timer": null },
    { "section": null, "text": "Add {olive-oil} and {pepper}. Blend briefly, until combined but still slightly chunky.", "timer": null },
    { "section": "Vegetables", "text": "Blanch {cabbage} in boiling salted water. Drain and set aside with {leek}.", "timer": 3 },
    { "section": null, "text": "After 2.5 h, add {carrot}, {turnip}, {celeriac} and {potato} to the broth. Simmer.", "timer": 20 },
    { "section": null, "text": "Add {leek} and {cabbage}. Simmer until all the vegetables are tender.", "timer": 20 },
    { "section": "Marrow and bread", "text": "Meanwhile, grill {marrow} cut side up on a hot grill until bubbling, soft and golden on top.", "timer": 15 },
    { "section": null, "text": "Off the grill, sprinkle with {sea-salt}.", "timer": null },
    { "section": null, "text": "Grill {bread} until charred on both sides. Rub immediately with {garlic}.", "timer": null },
    { "section": "Serving", "text": "Slice the meat thickly against the grain. Arrange on a warm platter: meat, vegetables, marrow bones, garlic bread.", "timer": null },
    { "section": null, "text": "Strain the broth into bowls. Put on the table: sauce verte, {mustard}, {sea-salt}.", "timer": null }
  ],
  "optional": null
}
