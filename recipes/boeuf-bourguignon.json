  "steps": [
    {
      "section": "Stew",
      "cue": "Start the oven",
      "text": "Preheat the oven to 180 °C conventional / 160 °C fan.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Crisp the bacon",
      "text": "Heat {olive-oil} in a large cast-iron pot over medium heat and add {bacon}. Cook until crisp and browned, then lift out with a slotted spoon.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Sear the beef",
      "text": "Raise the heat and, in batches, sear {chuck}. Brown on all sides, then set aside with the bacon.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Soften the vegetables",
      "text": "Lower the heat to medium and soften {onion} and {carrot}. Add {garlic-stew} and cook until fragrant.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Flour the meat",
      "text": "Return the bacon and beef to the pot and season with pepper. Sprinkle with {flour}, toss well and cook, stirring, until browned.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Add the liquid",
      "text": "Pour in {wine} and {stock}; the meat should be barely covered. Stir in {tomato-paste}, {thyme}, {bay} and {pearl-onion}, then bring to a simmer.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Braise",
      "text": "Cover and braise in the lower part of the oven until the meat is fall-apart tender. If the liquid boils rather than barely simmers, lower the oven.",
      "timer": 120
    },
    {
      "section": "Mushrooms",
      "cue": "Start the mushrooms",
      "text": "While the beef finishes, melt {butter} in a frying pan over medium-high heat and add {garlic-mushrooms}. Cook until fragrant, then add {mushroom}.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Brown the mushrooms",
      "text": "Cook, shaking the pan now and then, until browned.",
      "timer": 5
    },
    {
      "section": "Finishing",
      "cue": "Skim the sauce",
      "text": "Take the pot out of the oven and discard the thyme and bay leaves. Skim the fat off the surface.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Check the sauce",
      "text": "Reduce the sauce if it is thin: lift out the meat with a slotted spoon and boil until the sauce lightly coats the back of a spoon. Return the meat.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Heat through",
      "text": "Stir in the mushrooms and simmer gently to heat through.",
      "timer": 2
    },
    {
      "section": null,
      "cue": "Season and serve",
      "text": "Taste, then season with salt and pepper. Scatter with {parsley} and serve.",
