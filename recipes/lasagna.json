  "steps": [
    {
      "section": "Ragù",
      "cue": "Start with the garlic",
      "text": "Chop {garlic}. TM7: 3 sec / speed 7",
      "timer": null
    },
    {
      "section": null,
      "cue": "Chop the vegetables",
      "text": "Add {onion}, {celery} and {carrot}, chop and scrape down. TM7: 5 sec / speed 5",
      "timer": null
    },
    {
      "section": null,
      "cue": "Render the pancetta",
      "text": "Melt {butter-soffritto} in a large heavy pot over medium heat. Add {pancetta} and cook until browned and the fat renders.",
      "timer": 5
    },
    {
      "section": null,
      "cue": "Sweat the vegetables",
      "text": "Add the chopped vegetables and garlic with a pinch of salt. Cook over low heat until translucent and sweet, without browning.",
      "timer": 12
    },
    {
      "section": null,
      "cue": "Cook the meat",
      "text": "Add {beef} and {pork}, raise the heat to medium-high and break the meat up. Cook until it loses its raw colour and the liquid has cooked off.",
      "timer": 10
    },
    {
      "section": null,
      "cue": "Toast the tomato paste",
      "text": "Add {tomato-paste} and cook until it darkens slightly.",
      "timer": 2
    },
    {
      "section": null,
      "cue": "Deglaze with wine",
      "text": "Pour in {wine} and simmer until reduced by about half.",
      "timer": 3
    },
    {
      "section": null,
      "cue": "Build the sauce",
      "text": "Add {tomatoes}, {bay} and {parmesan-rind} and bring to a gentle simmer. Simmer with the lid ajar, stirring occasionally and adding a little water if it catches, until thick.",
      "timer": 60
    },
    {
      "section": null,
      "cue": "Enrich with milk",
      "text": "Add {milk-ragu} and simmer until thick and rich.",
      "timer": 20
    },
    {
      "section": null,
      "cue": "Finish the ragù",
      "text": "Remove the bay leaves and the Parmesan rind. Season to taste with salt and pepper.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Chill overnight",
      "text": "Cool, cover and refrigerate overnight, so the flavour rounds out and the fat sets.",
      "timer": null
    },
    {
      "section": "Next day",
      "cue": "Turn the oven on",
      "text": "Next day, heat the oven to 200 °C conventional / 180 °C fan.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Reheat the ragù",
      "text": "Lift off the fat that has set on top. Warm the ragù over medium-low heat, covered and stirring now and then, until hot through.",
      "timer": 20
    },
    {
      "section": "White sauce",
      "cue": "Start the white sauce",
      "text": "Meanwhile, melt {butter-sauce} in the TM7 bowl. TM7: 3 min / 100 °C / speed 1",
      "timer": null
    },
    {
      "section": null,
      "cue": "Cook the roux",
      "text": "Add {flour} and cook. TM7: 2 min / 100 °C / speed 1",
      "timer": null
    },
    {
      "section": null,
      "cue": "Cook the béchamel",
      "text": "Add {milk-white} and {nutmeg} and cook until thick enough to coat a spoon. TM7: 12 min / 90 °C / speed 4",
      "timer": null
    },
    {
      "section": null,
      "cue": "Check the seasoning",
      "text": "Season to taste with salt and pepper.",
      "timer": null
    },
    {
      "section": "Assembly",
      "cue": "Prepare the dishes",
      "text": "Grease a 23×33 cm baking dish and a small second dish with {butter-dish}. Set out {sheets} and {parmesan-layers}.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Start the layers",
      "text": "Spread a thin layer of ragù over the bottom of the large dish and cover with sheets.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Build the layers",
      "text": "Repeat until 2 cm below the rim: ragù, a generous layer of white sauce, a scattering of Parmesan, sheets. Finish with a thick layer of white sauce.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Fill the small dish",
      "text": "Build the small dish the same way with the rest.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Top with Parmesan",
      "text": "Over both dishes, scatter {parmesan-top}. Dot with {butter-top}.",
      "timer": null
    },
    {
      "section": "Baking",
      "cue": "Into the oven",
      "text": "Bake on a middle rack until bubbling at the edges and golden on top.",
      "timer": 25
    },
    {
      "section": null,
      "cue": "Leave to set",
      "text": "Rest before slicing.",
      "timer": 25
    }
  ]
}
