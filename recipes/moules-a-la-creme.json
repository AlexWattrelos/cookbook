  "steps": [
    {
      "section": null,
      "cue": "Clean the mussels",
      "text": "Rinse {mussels} under cold water, scrub if needed and pull off the beards. Discard any that are cracked or do not close when tapped.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Soften the shallots",
      "text": "Melt {butter} in a large pot over medium heat. Add {shallot} and cook until soft and translucent, without browning.",
      "timer": 3
    },
    {
      "section": null,
      "cue": "Add the garlic",
      "text": "Stir in {garlic} and cook until fragrant.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Add the wine",
      "text": "Pour in {wine} and bring to a lively simmer.",
      "timer": 1
    },
    {
      "section": null,
      "cue": "Steam the mussels",
      "text": "Add the mussels and cover. Steam, shaking the pot once or twice, until most have opened.",
      "timer": 4
    },
    {
      "section": null,
      "cue": "Stir in the cream",
      "text": "Lower the heat to medium-low, then stir in {pepper}, {espelette} and {creme-fraiche} until the sauce is smooth. Simmer, without boiling hard.",
      "timer": 1
    },
    {
      "section": null,
      "cue": "Finish the sauce",
      "text": "Stir in the juice of {lemon}. Taste, then salt only if needed: mussels can be salty.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Add the parsley",
      "text": "Turn off the heat and stir in {parsley}.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Serve",
      "text": "Ladle into bowls with plenty of sauce and serve immediately. Discard any mussels that stayed closed.",
