  "steps": [
    {
      "section": "Pork",
      "cue": "Render the pork",
      "text": "Set a large heavy pot over medium heat and add {pork}. Cook, turning now and then, until the fat has rendered and the cubes are golden all over.",
      "timer": 15
    },
    {
      "section": null,
      "cue": "Fry the aromatics",
      "text": "Spoon off the fat, leaving a thin film. Add {chilli}, {garlic}, {shallot} and {ginger} and fry until fragrant.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Caramelise the sugar",
      "text": "Sprinkle over {sugar} and stir until it melts and the pork is coated in a deep amber caramel.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Braise the pork",
      "text": "Add {fish-sauce}, {soy-sauce}, {water-braise} and {pepper}. Bring to a simmer, cover and cook on low heat until the pork is tender.",
      "timer": 45
    },
    {
      "section": "Rice",
      "cue": "Cook the rice",
      "text": "Halfway through the braise, put {water-rice} in a small pan with {rice} and bring to a boil. Cover and cook on the lowest heat until the water is absorbed.",
      "timer": 12
    },
    {
      "section": null,
      "cue": "Rest the rice",
      "text": "Take off the heat and leave covered.",
      "timer": 10
    },
    {
      "section": "Glaze",
      "cue": "Reduce the sauce",
      "text": "Once the pork is tender, uncover, raise the heat and simmer, stirring now and then, until the sauce is a sticky glaze that coats the pork.",
      "timer": 10
    },
    {
      "section": "Serving",
      "cue": "Plate the rice",
      "text": "Fluff the rice into bowls and top with the pork and its glaze.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Serve",
      "text": "Scatter with {spring-onion}. Put on the table: {lime}.",
      "timer": null
    }
  ]
