  "steps": [
    {
      "section": "Rice",
      "cue": "Start the rice",
      "text": "Bring {water} to a boil in a small pan and add {rice}. Cover and cook on the lowest heat until the water is absorbed.",
      "timer": 12
    },
    {
      "section": "Curry",
      "cue": "Fry the aromatics",
      "text": "Meanwhile, heat {oil} in a large deep pan over medium heat. Add {shallot}, {garlic} and {ginger} and cook, stirring, until soft and fragrant.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Toast the paste",
      "text": "Add {curry-paste} and stir until it darkens a shade and smells toasted.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Simmer the sauce",
      "text": "Pour in {coconut-milk}, {fish-sauce} and {sugar}. Bring to a gentle simmer and cook, uncovered, until slightly thickened.",
      "timer": 5
    },
    {
      "section": "Rice",
      "cue": "Rest the rice",
      "text": "Take the rice off the heat and leave it covered until serving.",
      "timer": null
    },
    {
      "section": "Salmon",
      "cue": "Poach the salmon",
      "text": "Salt both sides of {salmon} and lower into the sauce, spooning some over. Cover and simmer gently until just opaque at the thickest point.",
      "timer": 8
    },
    {
      "section": null,
      "cue": "Wilt the spinach",
      "text": "Tuck {spinach} into the sauce around the fish and cover until just wilted.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Finish the sauce",
      "text": "Turn off the heat and stir the juice of {lime-sauce} into the sauce. Taste and add salt if needed.",
      "timer": null
    },
    {
      "section": "Serving",
      "cue": "Serve",
      "text": "Fluff the rice into bowls and top with the salmon, spinach and sauce. Scatter with {coriander} and put on the table: {lime-serve}.",
      "timer": null
    }
  ]
