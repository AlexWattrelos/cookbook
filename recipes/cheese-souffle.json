      "timer": null
    },
    {
      "section": null,
      "cue": "Thicken the base",
      "text": "Add {milk}, {salt}, {white-pepper} and {nutmeg}. Cook until thick like yogurt. TM7: 5 min / 100 °C / speed 3",
      "timer": null
    },
    {
      "section": null,
      "cue": "Prepare the ramekins",
      "text": "Meanwhile, brush the ramekins with upward strokes of {butter-dish} and dust with {parmesan}.",
