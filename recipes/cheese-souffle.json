    },
    {
      "section": null,
      "cue": "Cool the base",
      "text": "Stir without heat to vent the steam. TM7: 2 min / speed 2",
      "timer": null
    },
    {
      "section": null,
      "cue": "Mix in the yolks",
      "text": "Add the egg yolks, just to combine. TM7: 15 sec / speed 3",
      "timer": null
    },
    {
      "section": "Fold and fill",
      "cue": "Season and transfer",
      "text": "Taste and season boldly: baking mutes it. Scrape the warm base into a large bowl.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Lighten the base",
      "text": "Briskly mix in about a quarter of the whites.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Incorporate the whites",
      "text": "Fold in the rest with a spatula: scoop under, lift, quarter turn. Stop while a few pale streaks remain.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Fill the ramekins",
      "text": "Spoon into the ramekins to 5 mm below the rim. Run a thumb around the inside rim to make a shallow channel, for an even top-hat rise.",
