    },
    {
      "section": null,
      "cue": "Start the emulsion",
      "text": "Pour in roughly a third of the melted butter. TM7: 1 min / 60 °C / speed 3, butterfly.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Thicken the sauce",
      "text": "Pour in the rest of the butter. TM7: 3 min / 80 °C / speed 3, butterfly.",
      "timer": null
    },
    {
