  "steps": [
    {
      "section": "Coffee",
      "cue": "Brew the coffee",
      "text": "Brew {espresso} first and let it cool.",
      "timer": null
    },
    {
      "section": "Cream",
      "cue": "Cook the zabaione",
      "text": "Put {sugar}, {marsala} and the yolks of {eggs} in the TM7 bowl. Cook until thick, pale and tripled in volume. TM7: 10 min / 70 °C / speed 4, butterfly",
      "timer": null
    },
    {
      "section": null,
      "cue": "Cool the zabaione",
      "text": "Scrape it into a large bowl and let it cool to room temperature, stirring now and then.",
      "timer": 30
    },
    {
      "section": null,
      "cue": "Whip the cream",
      "text": "Meanwhile, whip {cream} to soft peaks with a hand electric whisk.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Fold it together",
      "text": "In another bowl, loosen cold {mascarpone} and a pinch of salt with a spatula. Fold in the cooled zabaione in two additions, then the whipped cream, without overworking it.",
      "timer": null
    },
    {
      "section": "Assembly",
      "cue": "Prepare the ladyfingers",
      "text": "Dip {savoiardi} one at a time into the coffee, about 1 second per side. Do not soak them, or they collapse.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Build the first layer",
      "text": "Line the bottom of a 20×25 cm dish with a single layer of dipped ladyfingers. Spread half the cream over them and sift half of {cocoa} on top.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Build the second layer",
      "text": "Repeat with another layer of dipped ladyfingers, then the remaining cream.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Chill",
      "text": "Cover with cling film and refrigerate at least 6 h, ideally overnight.",
      "timer": null
    },
    {
      "section": "Serving",
      "cue": "Dust and serve",
      "text": "Just before serving, sift the rest of the cocoa over the top.",
      "timer": null
    }
  ]
