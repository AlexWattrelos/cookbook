  "steps": [
    {
      "section": "Coffee",
      "cue": "Make the coffee dip",
      "text": "Brew {espresso} and drop in one big ice cube to cool. Whisk in {cocoa-coffee} and {marsala} until dissolved.",
      "timer": null
    },
    {
      "section": "Cream",
      "cue": "Whisk the yolks",
      "text": "In a large bowl, beat {sugar} with the yolks of {eggs}. Beat with a hand electric whisk until pale, thick and doubled in volume.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Blend in the mascarpone",
      "text": "Add {mascarpone} and a pinch of salt. Whisk on low speed until just smooth, without overworking it.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Whip the cream",
      "text": "In a separate bowl, whip {cream} to soft peaks.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Whip the whites",
      "text": "In another clean bowl, whip the egg whites to stiff peaks.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Lighten the mascarpone",
      "text": "Fold the whipped cream into the mascarpone mixture with a spatula. Then gently fold in the egg whites in two additions, keeping it airy.",
      "timer": null
    },
    {
      "section": "Assembly",
      "cue": "Prepare the ladyfingers",
      "text": "Dip {savoiardi} one at a time into the coffee, about 1 second per side. Do not soak them, or they collapse.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Build the first layer",
      "text": "Line the bottom of a 20×25 cm dish with a single layer of dipped ladyfingers. Spread half the cream over them and dust with {cocoa-middle}.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Build the second layer",
      "text": "Repeat with another layer of dipped ladyfingers, then the remaining cream. Sift {cocoa-top} over the top.",
      "timer": null
    },
    {
      "section": null,
      "cue": "Chill",
      "text": "Cover with cling film and refrigerate at least 6 h, ideally overnight.",
      "timer": null
    }
  ]
